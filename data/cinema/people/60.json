.jpg","title":"Never Ending Man - Hayao Miyazaki","tmdb_id":459414,"type":"movie","year":2017}],"id":608,"known_for":[{"poster":"https://image.tmdb.org/t/p/w342/5LQLw0xUQtZUNg6cTk9gVR50CAB.jpg","title":"Lupin III","tmdb_id":31572,"type":"tv","year":1971},{"poster":"https://image.tmdb.org/t/p/w342/3PV6lq9BNmoyyDXr5tdNeeESEMn.jpg","title":"La città incantata","tmdb_id":129,"type":"movie","year":2001},{"poster":"https://image.tmdb.org/t/p/w342/5Sr9s8ZesaDKQhZl2fMuvOxIaxQ.jpg","title":"Il castello errante di Howl","tmdb_id":4935,"type":"movie","year":2004},{"poster":"https://image.tmdb.org/t/p/w342/3alL6upCn0GX9Rp1RXtGzmJbEQa.jpg","title":"Princess Mononoke","tmdb_id":128,"type":"movie","year":1997}],"name":"Hayao Miyazaki","photo":"https://image.tmdb.org/t/p/w342/ouhjt9KugzhWtdEyBPipihB3ic8.jpg","place_of_birth":"Tokyo, Japan","source":"tmdb"},"6368":{"id":6368,"known_for":[{"poster":"https://image.tmdb.org/t/p/w342/wYoDpWInsBEVSmWStnRH06ddoyk.jpg","title":"Matilda 6 mitica","tmdb_id":10830,"type":"movie","year":1996}],"name":"Embeth Davidtz","photo":"https://image.tmdb.org/t/p/w342/nwsdu9lOsKJ5v9RwOCc7kAiuxSO.jpg","source":"tmdb"},"80224":{"id":80224,"known_for":[{"poster":"https://image.tmdb.org/t/p/w342/kvFSpESyBZMjaeOJDx7RS3P1jey.jpg","title":"The Pitt","tmdb_id":250307,"type":"tv","year":2025}],"name":"Ned Brower","photo":"https://image.tmdb.org/t/p/w342/hO8CzIBdC3QU4HJbH6pVgsbvY2.jpg","source":"tmdb"},"83424":{"id":83424,"known_for":[{"poster":"https://image.tmdb.org/t/p/w342/MIINS3Q31PEYGM7d3mwJE5mV4L.jpg","title":"Backrooms","tmdb_id":1083381,"type":"movie","year":2026}],"name":"Peter New","photo":"https://image.tmdb.org/t/p/w342/bT71ieZH2qhgxLNTPyorMlVp3PN.jpg","source":"tmdb"},"87264":{"id":87264,"known_for":[{"poster":"https://image.tmdb.org/t/p/w342/9na3MNAhsuNKDVOoctaE7opTmbx.jpg","title":"Contra el huracán","tmdb_id":1780005,"type":"movie","year":2026}],"name":"Kristyan Ferrer","photo":"https://image.tmdb.org/t/p/w342/kTZDvbShqP4nd0UfzDphZsTR2KU.jpg","sou