t/p/w342/6s8Cyc4rxDRpX1vYnczU52RM4IM.jpg","source":"tmdb","stats":{"acting":1,"directing":0,"first_year":2025,"last_year":2025,"scope":"catalogue","works":1,"writing":0}},"1660946":{"id":1660946,"known_for":[{"poster":"https://image.tmdb.org/t/p/w342/aXetUcD4wfalCj90QmT6kSvwO6D.jpg","title":"Chad Powers","tmdb_id":247168,"type":"tv","year":2025}],"name":"Colin Woodell","photo":"https://image.tmdb.org/t/p/w342/mh32Sz1K8o7jUNGb4IGO4CRJhkQ.jpg","source":"tmdb","stats":{"acting":1,"directing":0,"first_year":2025,"last_year":2025,"scope":"catalogue","works":1,"writing":0}},"18":{"biography":"Bradley Harold Gerstenfeld (born April 14, 1960), known professionally as Brad Garrett, is an American actor and stand-up comedian.\n\nGarrett was initially successful as a stand-up comedian in the early 1980s. Taking advantage of that success in the late 1980s, Garrett began appearing in television and film in minor and guest roles. His breakthrough role was Robert Barone on the CBS sitcom Everybody Loves Raymond. The series debuted on September 13, 1996, running for nine seasons, during which Garrett was nominated for five Emmy Awards for Outstanding Supporting Actor in a Comedy Series, winning three. He gave a sixth Emmy-nominated performance as Jackie Gleason in the television film Gleason (2002).\n\nGarrett's other television roles include Eddie Stark on the Fox sitcom 'Til Death (2006 - 2010) and Douglas Fogerty on the ABC sitcom Single Parents (2018 - 2020). He served as creator and executive producer for Disney+'s Big Shot (2021 - 2022) with David E. Kelley and Dean Lorey.  Garrett is also a prolific voice actor. He has had main roles in animated series such as Hulk Hogan's Rock 'n' Wrestling (1985 - 1986) and 2 Stupid Dogs (1993 - 1995). From 2006 to 2014, he played the Easter Island Head in the Night at the Museum trilogy. Garrett has had other voice roles in five Pixar films in addition to many for Disney Animation and other studios.\n\nHe remains prominent in stand-up comedy and owns Brad Garrett's Comedy Club at the MGM Grand in Las Vegas, where he performs regularly.","biography_language":"en","biography_source":"tmdb","birthday":"1960-04-14","checked_at":"2026-11-26","deathday":"","filmography":[{"character":"Lord Grigon (voice)","poster":"https://image.tmdb.org/t/p/w342/kFxz2c6cmINliKSLoUm4r6m0B2B.jpg","role":"","title":"Elio","tmdb_id":1022787,"type":"movie","year":2025},{"character":"Borscht Belt Comedian","poster":"https://image.tmdb.org/t/p/w342/vYZWAkrnNwPc1KjeTQQAShWPya9.jpg","role":"","title":"Saturday Night","tmdb_id":1120911,"type":"movie","year":2024},{"character":"Otto (voice)","poster":"https://image.tmdb.org/t/p/w342/kdrYHOpfka3eS0S7kFdbU2jR0so.jpg","role":"","title":"WondLa","tmdb_id":237853,"type":"tv","year":2024},{"character":"Bruce Harvey","poster":"https://image.tmdb.org/t/p/w342/omY8gL9vLt3Qxp7ZnqvD756YAS4.jpg","role":"","title":"High Desert","tmdb_id":116793,"type":"tv","year":2023},{"character":"Duncan Rhodes","poster":"https://image.tmdb.org/t/p/w342/58jUrdbtBCi7X3MbszWo5OLmHaX.jpg","role":"","title":"Non sono ancora morta","tmdb_id":203178,"type":"tv","year":2023},{"character":"Greg","poster":"https://image.tmdb.org/t/p/w342/hsyN8kMDFb6coe0mmx9BJf2SQtc.jpg","role":"","title":"Cha Cha Real Smooth","tmdb_id":814340,"type":"movie","year":2022},{"character":"","poster":"https://image.tmdb.org/t/p/w342/5IY06xQ2YeSZhyj3SAa4AzSXWK9.jpg","role":"Ideazione","title":"Cambio di direzione","tmdb_id":96716,"type":"tv","year":2021},{"character":"Wise Kraken (voice)","poster":"https://image.tmdb.org/t/p/w342/7XkNkYXiqW8sS8SHzToVo5vmzbQ.jpg","role":"","title":"Kamp Koral: SpongeBob's Under Years","tmdb_id":99588,"type":"tv","year":2021},{"character":"Robert Otto (voice)","poster":"https://image.tmdb.org/t/p/w342/7ov9VoZYdwBlbDcFr72nxIw1L12.jpg","role":"","title":"Anfibia","tmdb_id":85349,"type":"tv","year":2019},{"character":"Dustin Mason","poster":"https://image.tmdb.org/t/p/w342/oTfAWQXUceUszmifA4AwkIsDccQ.jpg","role":